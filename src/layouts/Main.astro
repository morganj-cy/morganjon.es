---
import config from "@/website.config";

type OGType = "article" | "website";
type TwitterCardType = "summary" | "summary_large_image";

interface Props {
    title: string;
    description: string;
    image?: {
        path: string;
        alt: string;
    };
    ogType?: OGType;
    twitterCardType?: TwitterCardType;
}

const {
    title,
    description,
    image = {
        path: "/defaultAssets/ogIcon.png",
        alt: "A dark green gradient background, in the centre is a white colon followed by a lowercase m. The top dot of the colon is a glowing green colour.",
    },
    ogType = "website",
    twitterCardType = "summary",
} = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link
            rel="canonical"
            href={new URL(Astro.url.pathname, Astro.site).href}
        />

        <!-- Favicons -->
        <link rel="icon" type="image/svg+xml" href="/fav/favicon.svg" />
        <link rel="icon" href="/fav/favicon.ico" />
        <link rel="apple-touch-icon" href="/fav/apple-touch-icon.png" />

        <!-- RSS Discovery -->
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Morgan Jones' Blog"
            href={new URL("rss.xml", Astro.site)}
        />

        <!-- Bluesky & Mastodon -->
        <link rel="me" href={config.socials.bluesky} />
        <link rel="me" href={config.socials.mastodon} />
        <meta
            name="fediverse:creator"
            content={`@${config.mastodon.username}@${config.mastodon.instance}`}
        />

        <!-- Basic Meta -->
        <title>{title} | Morgan Jones</title>
        <meta name="description" content={description} />
        <meta name="theme-color" content="#122417" />

        <!-- Open Graph -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta
            property="og:image"
            content={new URL(image.path, Astro.site).href}
        />
        <meta property="og:image:alt" content={image.alt} />
        <meta property="og:type" content={ogType} />
        <meta property="og:locale" content="en_GB" />
        <meta
            property="og:url"
            content={new URL(Astro.url.pathname, Astro.site).href}
        />
        <meta property="og:site_name" content="Morgan Jones" />

        <!-- Twitter -->
        <meta name="twitter:card" content={twitterCardType} />
        <meta name="twitter:site" content={`@${config.twitterUsername}`} />
        <meta name="twitter:creator" content={`@${config.twitterUsername}`} />
        <meta name="twitter:image:alt" content={image.alt} />
    </head>
    <body>
        <slot />
    </body>
</html>
